# Copy this file to backend/.env and fill in real values. NEVER commit .env or real keys.

# Database: SQLite for quick local start, PostgreSQL for docker / Neon
DATABASE_URL=sqlite:///./sap_copilot.db
# DATABASE_URL=postgresql+psycopg2://sapcopilot:sapcopilot@localhost:5432/sapcopilot

# JWT - generate a long random string:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM - get a key at console.groq.com (router falls back to keyword rules if empty)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS - frontend URL
FRONTEND_ORIGIN=http://localhost:5173

# Optional usage limits for AI requests (0 = no limit). Useful for a public demo.
# AI_LIMIT_PER_HOUR=15
# AI_LIMIT_PER_DAY=300
